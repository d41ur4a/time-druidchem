{
  "name": "Orrery",
  "short_name": "Orrery",
  "description": "A private calendar of orbits: sun dial, galaxy, moon, and daily habits.",
  "start_url": "./#now",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#06050C",
  "theme_color": "#06050C",
  "icons": [
    {
      "src": "icons/icon-mac-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-mac-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "categories": [
    "productivity",
    "lifestyle"
  ]
}